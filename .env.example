# ---- Required in production ---------------------------------------------------
# Signs sessions and encrypts stored credentials. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INQUIRA_SECRET_KEY=

# ---- Optional ---------------------------------------------------------------
# INQUIRA_ENV=production
# INQUIRA_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/inquira   # default: SQLite in ./var
# INQUIRA_REDIS_URL=redis://localhost:6379/0                              # share rate limits across replicas
# INQUIRA_CORS_ORIGINS=https://inquira.example.com
# INQUIRA_SESSION_TTL_MINUTES=720
# INQUIRA_MAX_RESULT_ROWS=500
# INQUIRA_QUERY_TIMEOUT_SECONDS=30
# INQUIRA_ASK_RATE_LIMIT=30/minute
# INQUIRA_LOGIN_RATE_LIMIT=10/minute

# Configure the AI model from the environment instead of the onboarding UI
# (useful for GitOps / Kubernetes secrets). Overrides the stored setting.
# INQUIRA_LLM_PROVIDER=gemini            # gemini | anthropic | openai | openai_compatible
# INQUIRA_LLM_MODEL=gemini-2.5-flash
# INQUIRA_LLM_API_KEY=
# INQUIRA_LLM_BASE_URL=http://localhost:11434/v1
